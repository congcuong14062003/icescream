generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  LOCKED
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum StockStatus {
  AVAILABLE
  OUT_OF_STOCK
  INACTIVE
}

enum OrderStatus {
  DRAFT
  PENDING
  MAKING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  EWALLET
  MIXED
}

enum PromotionType {
  PERCENT
  FIXED_AMOUNT
  BUY_X_GET_Y
  PRODUCT
  CATEGORY
  MEMBER
  HAPPY_HOUR
}

enum InventoryTransactionType {
  IMPORT
  SALE
  ADJUST_IN
  ADJUST_OUT
  TRANSFER_IN
  TRANSFER_OUT
  WASTE
  STOCKTAKE
  REFUND
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PointTransactionType {
  EARN
  REDEEM
  ADJUST
  BIRTHDAY
  EXPIRE
}

enum VoucherDiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum VoucherStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum VoucherIssueReason {
  TIER_UPGRADE
  QUALIFYING_ORDER
  MANUAL
}

enum MembershipSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum StockIssueReason {
  INTERNAL_USE
  DAMAGED
  EXPIRED
  SAMPLE
  OTHER
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?          @db.Text
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([name])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  module      String
  description String?          @db.Text
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module, code])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Branch {
  id                      String                   @id @default(cuid())
  code                    String                   @unique
  name                    String
  address                 String                   @db.VarChar(500)
  phone                   String
  openingHours            String?
  managerId               String?
  isActive                Boolean                  @default(true)
  deletedAt               DateTime?
  manager                 User?                    @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  users                   User[]                   @relation("UserBranch")
  inventories             Inventory[]
  inventoryBatch          InventoryBatch[]
  inventoryTxs            InventoryTransaction[]   @relation("TransactionBranch")
  transferFrom            InventoryTransaction[]   @relation("TransactionFromBranch")
  transferTo              InventoryTransaction[]   @relation("TransactionToBranch")
  orders                  Order[]
  purchaseOrders          PurchaseOrder[]
  shifts                  WorkShift[]
  stockIssues             StockIssue[]
  stocktakes              Stocktake[]
  membershipSubscriptions MembershipSubscription[]
  customerVouchers        CustomerVoucher[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([name])
  @@index([isActive, createdAt])
}

model User {
  id                             String                   @id @default(cuid())
  username                       String                   @unique
  email                          String                   @unique
  passwordHash                   String
  fullName                       String
  phone                          String?
  avatarUrl                      String?                  @db.Text
  status                         AccountStatus            @default(ACTIVE)
  roleId                         String
  branchId                       String?
  lastLoginAt                    DateTime?
  passwordResetHash              String?
  passwordResetExpires           DateTime?
  deletedAt                      DateTime?
  role                           Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch                         Branch?                  @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  managedBranches                Branch[]                 @relation("BranchManager")
  refreshTokens                  RefreshToken[]
  loginHistories                 LoginHistory[]
  createdOrders                  Order[]                  @relation("OrderCreator")
  assignedOrders                 Order[]                  @relation("OrderAssignee")
  orderStatusChanges             OrderStatusHistory[]
  paymentStatusChanges           PaymentStatusHistory[]
  inventoryTransactions          InventoryTransaction[]
  purchaseOrders                 PurchaseOrder[]
  shifts                         WorkShift[]
  shiftExpenses                  ShiftExpense[]
  refunds                        Refund[]
  createdStockIssues             StockIssue[]             @relation("StockIssueCreator")
  createdStocktakes              Stocktake[]              @relation("StocktakeCreator")
  createdMembershipSubscriptions MembershipSubscription[] @relation("MembershipSubscriptionCreator")
  createdCustomerVouchers        CustomerVoucher[]        @relation("CustomerVoucherCreator")
  auditLogs                      AuditLog[]
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt

  @@index([fullName])
  @@index([status, createdAt])
  @@index([branchId, roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  userAgent String?   @db.Text
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?  @db.Text
  success   Boolean
  reason    String?  @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Category {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String              @unique
  description  String?             @db.Text
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  deletedAt    DateTime?
  products     Product[]
  promotions   PromotionCategory[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([name])
  @@index([isActive, displayOrder])
}

model Product {
  id              String                  @id @default(cuid())
  code            String                  @unique
  name            String
  categoryId      String
  description     String?                 @db.Text
  imageUrl        String?                 @db.Text
  price           Int
  costPrice       Int
  status          ProductStatus           @default(ACTIVE)
  isFeatured      Boolean                 @default(false)
  displayOrder    Int                     @default(0)
  deletedAt       DateTime?
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  variants        ProductVariant[]
  recipes         ProductRecipe[]
  promotions      PromotionProduct[]
  orderItems      OrderItem[]
  membershipPlans MembershipPlanProduct[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([name])
  @@index([status, createdAt])
  @@index([categoryId, status, displayOrder])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String   @db.Text
  publicId     String?
  displayOrder Int      @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, displayOrder])
}

model ProductVariant {
  id                     String           @id @default(cuid())
  productId              String
  sku                    String           @unique
  name                   String
  size                   String?
  cupType                String?
  scoopCount             Int              @default(1)
  price                  Int
  costPrice              Int
  isActive               Boolean          @default(true)
  product                Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipes                ProductRecipe[]
  orderItems             OrderItem[]
  membershipBenefitPlans MembershipPlan[] @relation("MembershipBenefitVariant")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([productId, isActive])
  @@index([name])
}

model Flavor {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String             @unique
  color       String
  imageUrl    String?            @db.Text
  extraPrice  Int                @default(0)
  status      StockStatus        @default(AVAILABLE)
  deletedAt   DateTime?
  ingredients FlavorIngredient[]
  recipes     ProductRecipe[]
  orderItems  OrderItemFlavor[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([name])
  @@index([status, createdAt])
}

model FlavorIngredient {
  flavorId     String
  ingredientId String
  quantity     Float
  flavor       Flavor     @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([flavorId, ingredientId])
}

model Topping {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String             @unique
  imageUrl    String?            @db.Text
  price       Int
  costPrice   Int
  stockStatus StockStatus        @default(AVAILABLE)
  deletedAt   DateTime?
  recipes     ProductRecipe[]
  orderItems  OrderItemTopping[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([name])
  @@index([stockStatus, createdAt])
}

model Ingredient {
  id                String                 @id @default(cuid())
  code              String                 @unique
  name              String
  unit              String
  minStock          Float                  @default(0)
  lastCost          Int                    @default(0)
  averageCost       Int                    @default(0)
  supplierId        String?
  defaultExpiryDays Int?
  warehouseLocation String?
  isActive          Boolean                @default(true)
  deletedAt         DateTime?
  supplier          Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventories       Inventory[]
  batches           InventoryBatch[]
  transactions      InventoryTransaction[]
  recipes           ProductRecipe[]
  flavorIngredients FlavorIngredient[]
  purchaseItems     PurchaseOrderItem[]
  stockIssueItems   StockIssueItem[]
  stocktakeItems    StocktakeItem[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([name])
  @@index([isActive, createdAt])
}

model ProductRecipe {
  id           String          @id @default(cuid())
  productId    String?
  variantId    String?
  flavorId     String?
  toppingId    String?
  ingredientId String
  quantity     Float
  note         String?         @db.Text
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  flavor       Flavor?         @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  topping      Topping?        @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([flavorId])
  @@index([toppingId])
  @@index([ingredientId])
}

model Inventory {
  id           String     @id @default(cuid())
  branchId     String
  ingredientId String
  quantity     Float      @default(0)
  reserved     Float      @default(0)
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([branchId, ingredientId])
  @@index([quantity])
}

model InventoryBatch {
  id              String             @id @default(cuid())
  branchId        String
  ingredientId    String
  purchaseItemId  String?
  batchNumber     String
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Float
  remaining       Float
  unitCost        Int
  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredient      Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  purchaseItem    PurchaseOrderItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([branchId, ingredientId, batchNumber])
  @@index([expiryDate, remaining])
  @@index([branchId, ingredientId])
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  code          String                   @unique
  type          InventoryTransactionType
  branchId      String
  fromBranchId  String?
  toBranchId    String?
  ingredientId  String
  quantity      Float
  balanceAfter  Float
  unitCost      Int?
  referenceType String?
  referenceId   String?
  note          String?                  @db.Text
  createdById   String
  branch        Branch                   @relation("TransactionBranch", fields: [branchId], references: [id], onDelete: Restrict)
  fromBranch    Branch?                  @relation("TransactionFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch      Branch?                  @relation("TransactionToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)
  ingredient    Ingredient               @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdBy     User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([branchId, ingredientId, createdAt])
  @@index([type, createdAt])
}

model StockIssue {
  id          String           @id @default(cuid())
  code        String           @unique
  branchId    String
  createdById String
  reason      StockIssueReason
  note        String?          @db.Text
  totalCost   Int              @default(0)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("StockIssueCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       StockIssueItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branchId, createdAt])
  @@index([reason, createdAt])
  @@index([createdById, createdAt])
}

model StockIssueItem {
  id           String     @id @default(cuid())
  stockIssueId String
  ingredientId String
  quantity     Float
  unitCost     Int
  lineCost     Int
  stockIssue   StockIssue @relation(fields: [stockIssueId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([stockIssueId, ingredientId])
  @@index([ingredientId, createdAt])
}

model Stocktake {
  id                String          @id @default(cuid())
  code              String          @unique
  branchId          String
  createdById       String
  note              String?         @db.Text
  totalVarianceCost Int             @default(0)
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy         User            @relation("StocktakeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items             StocktakeItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([branchId, createdAt])
  @@index([createdById, createdAt])
}

model StocktakeItem {
  id             String     @id @default(cuid())
  stocktakeId    String
  ingredientId   String
  systemQuantity Float
  actualQuantity Float
  difference     Float
  unitCost       Int
  varianceCost   Int
  stocktake      Stocktake  @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([stocktakeId, ingredientId])
  @@index([ingredientId, createdAt])
}

model Supplier {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?         @db.VarChar(500)
  outstandingDebt Int             @default(0)
  isActive        Boolean         @default(true)
  deletedAt       DateTime?
  ingredients     Ingredient[]
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([name])
  @@index([isActive, createdAt])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  code        String              @unique
  supplierId  String
  branchId    String
  createdById String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Int                 @default(0)
  note        String?             @db.Text
  approvedAt  DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([branchId, createdAt])
}

model PurchaseOrderItem {
  id              String           @id @default(cuid())
  purchaseOrderId String
  ingredientId    String
  quantity        Float
  unitCost        Int
  lineTotal       Int
  batchNumber     String?
  manufactureDate DateTime?
  expiryDate      DateTime?
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient      Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batches         InventoryBatch[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([purchaseOrderId])
  @@index([ingredientId])
}

model MembershipLevel {
  id                           String              @id @default(cuid())
  code                         String              @unique
  name                         String
  minSpending                  Int
  minPoints                    Int                 @default(0)
  pointRate                    Float
  pointValue                   Int                 @default(1000)
  birthdayDiscount             Int                 @default(0)
  voucherEnabled               Boolean             @default(false)
  voucherType                  VoucherDiscountType @default(FIXED_AMOUNT)
  voucherValue                 Int                 @default(0)
  voucherMaxDiscount           Int?
  voucherMinOrderValue         Int                 @default(0)
  voucherValidityDays          Int                 @default(15)
  voucherCooldownDays          Int                 @default(15)
  voucherRenewalOrderMinAmount Int                 @default(200000)
  displayOrder                 Int                 @default(0)
  customers                    Customer[]
  vouchers                     CustomerVoucher[]
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  @@index([minSpending])
  @@index([minPoints])
}

model Customer {
  id                      String                     @id @default(cuid())
  code                    String                     @unique
  fullName                String
  phone                   String                     @unique
  email                   String?                    @unique
  dateOfBirth             DateTime?
  address                 String?                    @db.VarChar(500)
  membershipLevelId       String
  totalSpending           Int                        @default(0)
  totalOrders             Int                        @default(0)
  points                  Int                        @default(0)
  deletedAt               DateTime?
  membershipLevel         MembershipLevel            @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict)
  pointTransactions       CustomerPointTransaction[]
  orders                  Order[]
  promotionUsages         PromotionUsage[]
  membershipSubscriptions MembershipSubscription[]
  vouchers                CustomerVoucher[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([fullName])
  @@index([phone])
  @@index([createdAt])
}

model MembershipPlan {
  id                String                   @id @default(cuid())
  code              String                   @unique
  name              String
  description       String?                  @db.Text
  price             Int
  durationDays      Int
  dailyFreeQuantity Int                      @default(1)
  benefitVariantId  String?
  isActive          Boolean                  @default(true)
  benefitVariant    ProductVariant?          @relation("MembershipBenefitVariant", fields: [benefitVariantId], references: [id], onDelete: Restrict)
  products          MembershipPlanProduct[]
  subscriptions     MembershipSubscription[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([name])
  @@index([isActive, createdAt])
  @@index([benefitVariantId])
}

model MembershipPlanProduct {
  membershipPlanId String
  productId        String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([membershipPlanId, productId])
  @@index([productId])
}

model MembershipSubscription {
  id               String                       @id @default(cuid())
  code             String                       @unique
  customerId       String
  membershipPlanId String
  branchId         String
  createdById      String
  startsAt         DateTime
  endsAt           DateTime
  amountPaid       Int
  paymentMethod    PaymentMethod
  referenceCode    String?
  status           MembershipSubscriptionStatus @default(ACTIVE)
  note             String?                      @db.Text
  customer         Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  membershipPlan   MembershipPlan               @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  branch           Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy        User                         @relation("MembershipSubscriptionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  benefitUsages    MembershipBenefitUsage[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([customerId, status, startsAt, endsAt])
  @@index([membershipPlanId, createdAt])
  @@index([branchId, createdAt])
  @@index([createdById, createdAt])
}

model MembershipBenefitUsage {
  id             String                 @id @default(cuid())
  subscriptionId String
  orderId        String                 @unique
  benefitDate    DateTime               @db.Date
  quantity       Int                    @default(1)
  discountAmount Int
  subscription   MembershipSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())

  @@unique([subscriptionId, benefitDate])
  @@index([benefitDate, createdAt])
}

model CustomerPointTransaction {
  id           String               @id @default(cuid())
  customerId   String
  orderId      String?
  type         PointTransactionType
  points       Int
  balanceAfter Int
  description  String?              @db.Text
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([customerId, createdAt])
}

model Promotion {
  id               String              @id @default(cuid())
  code             String              @unique
  name             String
  description      String?             @db.Text
  type             PromotionType
  value            Int
  startAt          DateTime
  endAt            DateTime
  minOrderValue    Int                 @default(0)
  maxDiscount      Int?
  totalUsageLimit  Int?
  usagePerCustomer Int                 @default(1)
  buyQuantity      Int?
  getQuantity      Int?
  startHour        Int?
  endHour          Int?
  memberOnly       Boolean             @default(false)
  isActive         Boolean             @default(true)
  products         PromotionProduct[]
  categories       PromotionCategory[]
  usages           PromotionUsage[]
  orders           Order[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([isActive, startAt, endAt])
  @@index([name])
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
}

model PromotionUsage {
  id          String    @id @default(cuid())
  promotionId String
  customerId  String?
  orderId     String    @unique
  discount    Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([promotionId, createdAt])
  @@index([customerId, promotionId])
}

model CustomerVoucher {
  id                String              @id @default(cuid())
  code              String              @unique
  customerId        String
  membershipLevelId String
  branchId          String
  createdById       String?
  issuedFromOrderId String?
  usedOrderId       String?             @unique
  type              VoucherDiscountType
  value             Int
  maxDiscount       Int?
  minOrderValue     Int                 @default(0)
  issueReason       VoucherIssueReason
  status            VoucherStatus       @default(ACTIVE)
  expiresAt         DateTime
  usedAt            DateTime?
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  membershipLevel   MembershipLevel     @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict)
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy         User?               @relation("CustomerVoucherCreator", fields: [createdById], references: [id], onDelete: SetNull)
  issuedFromOrder   Order?              @relation("VoucherIssuedOrder", fields: [issuedFromOrderId], references: [id], onDelete: SetNull)
  usedOrder         Order?              @relation("VoucherUsedOrder", fields: [usedOrderId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([customerId, status, expiresAt])
  @@index([branchId, status, expiresAt])
  @@index([createdById, createdAt])
  @@index([membershipLevelId, createdAt])
  @@index([issuedFromOrderId])
}

model Order {
  id                     String                     @id @default(cuid())
  code                   String                     @unique
  branchId               String
  customerId             String?
  createdById            String
  assignedToId           String?
  shiftId                String?
  promotionId            String?
  originalAmount         Int
  discountAmount         Int                        @default(0)
  voucherDiscount        Int                        @default(0)
  pointsDiscount         Int                        @default(0)
  membershipDiscount     Int                        @default(0)
  vatRate                Float                      @default(0)
  taxAmount              Int                        @default(0)
  deliveryFee            Int                        @default(0)
  totalAmount            Int
  customerPaid           Int                        @default(0)
  changeAmount           Int                        @default(0)
  paymentStatus          PaymentStatus              @default(UNPAID)
  status                 OrderStatus                @default(PENDING)
  note                   String?                    @db.Text
  cancellationReason     String?                    @db.Text
  completedAt            DateTime?
  cancelledAt            DateTime?
  branch                 Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer               Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy              User                       @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo             User?                      @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  shift                  WorkShift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  promotion              Promotion?                 @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  payments               Payment[]
  refunds                Refund[]
  statusHistory          OrderStatusHistory[]
  paymentStatusHistory   PaymentStatusHistory[]
  pointTransactions      CustomerPointTransaction[]
  promotionUsage         PromotionUsage?
  membershipBenefitUsage MembershipBenefitUsage?
  issuedVouchers         CustomerVoucher[]          @relation("VoucherIssuedOrder")
  usedVoucher            CustomerVoucher?           @relation("VoucherUsedOrder")
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdById, createdAt])
}

model OrderItem {
  id             String             @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  productName    String
  variantName    String?
  sku            String
  unitPrice      Int
  quantity       Int
  scoopCount     Int                @default(0)
  discountAmount Int                @default(0)
  lineTotal      Int
  note           String?            @db.Text
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  flavors        OrderItemFlavor[]
  toppings       OrderItemTopping[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([orderId])
  @@index([productId, createdAt])
}

model OrderItemFlavor {
  id          String    @id @default(cuid())
  orderItemId String
  flavorId    String
  scoopNumber Int
  extraPrice  Int       @default(0)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  flavor      Flavor    @relation(fields: [flavorId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@unique([orderItemId, scoopNumber])
  @@index([flavorId, createdAt])
}

model OrderItemTopping {
  id          String    @id @default(cuid())
  orderItemId String
  toppingId   String
  quantity    Int       @default(1)
  price       Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping     Topping   @relation(fields: [toppingId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@unique([orderItemId, toppingId])
  @@index([toppingId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  code          String        @unique
  orderId       String
  method        PaymentMethod
  amount        Int
  referenceCode String?
  note          String?       @db.Text
  paidAt        DateTime      @default(now())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId, paidAt])
  @@index([method, paidAt])
}

model Refund {
  id          String        @id @default(cuid())
  code        String        @unique
  orderId     String
  createdById String
  amount      Int
  method      PaymentMethod
  reason      String        @db.Text
  status      RefundStatus  @default(COMPLETED)
  refundedAt  DateTime?
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId, createdAt])
}

model WorkShift {
  id              String         @id @default(cuid())
  code            String         @unique
  branchId        String
  userId          String
  status          ShiftStatus    @default(OPEN)
  openingCash     Int
  cashRevenue     Int            @default(0)
  transferRevenue Int            @default(0)
  cardRevenue     Int            @default(0)
  ewalletRevenue  Int            @default(0)
  refundAmount    Int            @default(0)
  expenseAmount   Int            @default(0)
  expectedCash    Int?
  countedCash     Int?
  difference      Int?
  openedAt        DateTime       @default(now())
  closedAt        DateTime?
  note            String?        @db.Text
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders          Order[]
  expenses        ShiftExpense[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([branchId, status])
  @@index([userId, status])
  @@index([openedAt])
}

model ShiftExpense {
  id          String    @id @default(cuid())
  shiftId     String
  createdById String
  category    String
  amount      Int
  description String    @db.Text
  shift       WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shiftId, createdAt])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  changedById String
  note        String?     @db.Text
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@index([orderId, createdAt])
}

model PaymentStatusHistory {
  id          String         @id @default(cuid())
  orderId     String
  fromStatus  PaymentStatus?
  status      PaymentStatus
  changedById String
  amount      Int?
  method      PaymentMethod?
  note        String?        @db.Text
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User           @relation(fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
