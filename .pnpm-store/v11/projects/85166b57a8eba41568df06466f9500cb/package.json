{
  "name": "icecream-pos-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "db:prepare": "prisma generate && prisma migrate deploy && node prisma/seed.js --if-empty",
    "db:deploy": "prisma migrate deploy && node prisma/seed.js --if-empty",
    "postinstall": "prisma generate",
    "predev": "npm run db:deploy",
    "dev": "nodemon src/server.js",
    "prestart": "npm run db:deploy",
    "start": "node src/server.js",
    "build": "prisma generate && node scripts/check-source.js",
    "test": "node --test tests/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.16.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.7.0",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
